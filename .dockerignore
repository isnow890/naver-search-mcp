# Credentials — must never be baked into an image layer.
.env
.env.*

# Installed on the host; the image runs its own `npm install`.
# Copying the host's node_modules over it can also clobber
# platform-specific binaries (e.g. sharp) with the wrong platform's build.
node_modules

# VCS metadata — not needed at build or run time.
.git
.gitignore

# Build output — regenerated by `RUN npm run build` (prebuild removes it anyway).
dist

# Agent/tooling configuration — irrelevant to the running server.
.claude
.superpowers

# Not needed inside the image.
tests
scripts
skills

# Documentation.
*.md

# Misc local/OS artifacts.
.DS_Store
*.log
coverage
